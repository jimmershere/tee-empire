# Copy to .env and fill in. The CLI auto-loads /app/cc/empire/.env if present.

# --- Concept generation (optional, falls back to deterministic templates) ---
XAI_API_KEY=

# --- Image generation backend (defaults: kieai -> openrouter -> openai -> comfyui -> placeholder) ---
EMPIRE_IMAGE_BACKEND=                  # leave blank for auto (kieai preferred)
KIEAI_API_KEY=
KIEAI_MODEL=flux-kontext-pro
KIEAI_ASPECT=1:1
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-schnell   # or a supported SD3/FLUX variant
EMPIRE_OPENROUTER_VARIANTS=3
OPENAI_API_KEY=
COMFYUI_URL=
COMFYUI_URLS=
COMFYUI_WORKFLOW_TEMPLATE=
# Future local inference
# OLLAMA_URL=http://localhost:11434
# EMPIRE_OLLAMA_MODEL=llama3.2-vision or a txt2img bridge

# --- Printify (per-brand shop IDs are also configurable in brand.yaml) ---
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# --- Etsy Open API v3 (PAT mode) ---
ETSY_API_KEY=
ETSY_OAUTH_TOKEN=
ETSY_SHOP_ID=

# --- PostBridge (cross-promote merch drops to social; shared with content-machine) ---
POST_BRIDGE_API_KEY=

# --- Drop folder ---
EMPIRE_INBOX=
EMPIRE_CIRCULAR_DROP=0                  # 0=off (default), 1=force circular logo trim on all drops, blank=auto by keyword

# --- Telegram HITL ---
TELEGRAM_BOT_TOKEN=
DEFAULT_REVIEW_CHAT_ID=
